# Server Configurations
PORT=5000
NODE_ENV=development

# Database Settings
# Replace user, password, host, port, and dbname with your local Postgres settings.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_aggregator?schema=public"

# Authentication Security
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Third-party Integrations
OPENAI_API_KEY="" # Optional. If empty, local mock parsing and mock embeddings will be utilized.
